# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.

# Neon Postgres connection string (Neon console -> Connect -> copy the pooled URL).
# Leave blank to run in demo mode: responses stay in memory and vanish on restart.
DATABASE_URL=

# Anthropic API key (console.anthropic.com -> API keys). Needed for the AI summary.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
